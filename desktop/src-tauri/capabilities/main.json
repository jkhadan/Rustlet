{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The app's window: Tauri's core defaults (events, the window, paths) and the app's own commands, nothing else.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-daemon-socket",
    "allow-daemon-version",
    "allow-daemon-info",
    "allow-daemon-watch",
    "allow-daemon-start",
    "allow-parse-run-options",
    "allow-container-list",
    "allow-container-inspect",
    "allow-container-create",
    "allow-container-start",
    "allow-container-stop",
    "allow-container-restart",
    "allow-container-kill",
    "allow-container-pause",
    "allow-container-unpause",
    "allow-container-remove",
    "allow-container-isolation",
    "allow-container-logs",
    "allow-container-stats",
    "allow-container-commit",
    "allow-stream-cancel",
    "allow-terminal-open",
    "allow-terminal-input",
    "allow-terminal-resize",
    "allow-terminal-close",
    "allow-image-list",
    "allow-image-inspect",
    "allow-image-remove",
    "allow-image-pull",
    "allow-image-tag",
    "allow-image-save",
    "allow-image-load",
    "allow-image-build",
    "allow-build-prune",
    "allow-stack-list",
    "allow-compose-up",
    "allow-compose-down",
    "allow-network-list",
    "allow-network-inspect",
    "allow-network-create",
    "allow-network-remove",
    "allow-network-connect",
    "allow-network-disconnect",
    "allow-network-prune",
    "allow-volume-list",
    "allow-volume-inspect",
    "allow-volume-create",
    "allow-volume-remove",
    "allow-volume-prune"
  ]
}
