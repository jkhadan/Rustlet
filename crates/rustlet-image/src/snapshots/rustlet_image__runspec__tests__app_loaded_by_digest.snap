    "org.opencontainers.image.author": "Example Ops <ops@example.com>",
    "org.opencontainers.image.created": "2019-03-01T12:00:00Z",
    "org.opencontainers.image.exposedPorts": "8080/tcp,8125/udp,9090/tcp",
    "org.opencontainers.image.os": "linux",
    "org.opencontainers.image.source": "https://git.example.com/app",
    "org.opencontainers.image.stopSignal": "SIGINT"
